# Copy to frontend/.env and set the address of YOUR backend (must end with /api). Restart Expo with: npx expo start -c
#
# Physical Android phone on the same Wi-Fi as your PC:  http://<PC_LAN_IP>:5000/api
# Android emulator:                                      http://10.0.2.2:5000/api
# USB cable (after: adb reverse tcp:5000 tcp:5000):      http://localhost:5000/api
# Production (EAS build / deployed backend):             https://your-backend.onrender.com/api
EXPO_PUBLIC_API_URL=http://192.168.68.199:5000/api

# The CompareProjects website, used for shared property links (<url>/property/<id>).
# Leave empty until the site is live; the app then hides "View on website" and shares without a link.
EXPO_PUBLIC_WEB_URL=

# Sentry crash/error reporting (optional; empty = off). DSN of the React Native project in Sentry.
# Off in development builds unless EXPO_PUBLIC_SENTRY_IN_DEV=true (handy for a one-off test).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_IN_DEV=
# Optional: environment label (default production/development) and share of sessions traced (0 = errors only).
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
#
# Source map upload for readable release stack traces is configured at BUILD time, not here:
# set SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN (an EAS secret) for release/EAS builds, or
# SENTRY_DISABLE_AUTO_UPLOAD=true to build a release without uploading.
